DirectoryIndex dist/index.html index.html index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # Prevent direct browser access to sensitive system files
    RewriteRule ^(\.env|\.git|composer\.|package\.|tsconfig|artisan) - [F,L]

    # Route /api and /storage requests to Laravel backend (public/index.php) if present
    RewriteCond %{REQUEST_URI} ^/(api|storage) [NC]
    RewriteCond %{DOCUMENT_ROOT}/public/index.php -f
    RewriteRule ^ public/index.php [L]

    # If requested file exists in dist (e.g. /assets/..., /images/..., /favicon.ico)
    RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
    RewriteRule ^(.*)$ dist/$1 [L]

    # If visiting root domain, serve dist/index.html
    RewriteRule ^$ dist/index.html [L]

    # SPA routing fallback: send all non-file requests to dist/index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ dist/index.html [L]
</IfModule>
